# ====================================================================
# HomeAI Core Backend — environment template
# ====================================================================
# Copy to `.env` and fill in. The schema is validated at boot in
# src/config/env.ts (zod) — required vars missing or malformed will
# fail-fast with a clear error. The AI service has its own `.env.example`
# at `../../ai-service/.env.example`; some values must agree between the
# two (JWT_SECRET, GRPC_PORT) — those are noted in-line.
# ====================================================================


# --------------------------------------------------------------------
# HTTP server
# --------------------------------------------------------------------

# OPTIONAL — default: development. One of: development | production | test
NODE_ENV=development

# OPTIONAL — default: 3000. The Express HTTP surface listens here.
PORT=3000

# OPTIONAL — default: 50051. gRPC mutation surface served alongside
# Express on this port. Loopback-only in dev. The AI service must point
# `CORE_BACKEND_GRPC_PORT` at this same value.
GRPC_PORT=50051

# OPTIONAL — default: v1. Mounted at `/api/<API_VERSION>/...`.
API_VERSION=v1


# --------------------------------------------------------------------
# Database — Neon Postgres (managed)
# --------------------------------------------------------------------
# Two URLs by design: the pooled endpoint for runtime queries and the
# direct (non-pooled) endpoint for Prisma migrations.

# REQUIRED. Pooled connection — runtime queries.
# Hostname has `-pooler` in it.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# REQUIRED for `prisma migrate` / `prisma db pull`. Direct (non-pooled)
# connection — session-level features that the pooler in transaction
# mode does not support. Hostname omits `-pooler`.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# Local Postgres fallback (docker-compose) — uncomment to use instead of Neon.
# docker-compose.yml exposes the container on host port 5433.
# DATABASE_URL=postgresql://homeai:homeai_dev@localhost:5433/homeai_dev?schema=public
# DIRECT_URL=postgresql://homeai:homeai_dev@localhost:5433/homeai_dev?schema=public


# --------------------------------------------------------------------
# Redis (sessions, rate-limit, cache — optional in dev)
# --------------------------------------------------------------------

# OPTIONAL. When unset, falls back to in-memory equivalents.
REDIS_URL=redis://localhost:6379


# --------------------------------------------------------------------
# JWT — must be shared with the AI service
# --------------------------------------------------------------------

# REQUIRED — min 32 chars. The AI service's JWT_SECRET MUST be the
# same value, byte-for-byte. JWTs minted by /auth/login here are
# validated identically on the AI service's /v1/chat.
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# OPTIONAL — default: 15m
JWT_EXPIRES_IN=15m

# OPTIONAL — default: 7d
JWT_REFRESH_EXPIRES_IN=7d


# --------------------------------------------------------------------
# Region routing
# --------------------------------------------------------------------

# OPTIONAL — default: NG. Two-letter region code; selects which
# third-party providers initialize (NG → Paystack/Smile/Africa's Talking,
# else Stripe/Onfido/Twilio).
DEFAULT_REGION=NG

# =====================================
# NIGERIA PROVIDERS
# =====================================

# Payment - Paystack (Nigeria)
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx

# Identity Verification - Smile Identity (Nigeria)
SMILE_IDENTITY_API_KEY=xxxxx
SMILE_IDENTITY_PARTNER_ID=xxxxx

# SMS - Africa's Talking (Nigeria)
AT_API_KEY=xxxxx
AT_USERNAME=sandbox
AT_SENDER_ID=HomeAI

# =====================================
# CANADA PROVIDERS
# =====================================

# Payment - Stripe (Canada)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Identity Verification - Onfido (Canada)
ONFIDO_API_TOKEN=xxxxx
ONFIDO_SANDBOX=true

# SMS - Twilio (Canada)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# =====================================
# SHARED PROVIDERS (All Regions)
# =====================================

# Email - SendGrid
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=noreply@homeai.ng

# Push - Firebase
FCM_PROJECT_ID=homeai-ng
FCM_PRIVATE_KEY=xxxxx
FCM_CLIENT_EMAIL=xxxxx

# Storage - AWS S3
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_REGION=eu-west-1
AWS_S3_BUCKET=homeai-ng-uploads
AWS_CLOUDFRONT_DOMAIN=d1234567890abc.cloudfront.net

# Maps - Google
GOOGLE_MAPS_API_KEY=xxxxx

# Blockchain (Polygon)
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/xxxxx
BLOCKCHAIN_PRIVATE_KEY=xxxxx
ALCHEMY_API_KEY=xxxxx
INFURA_API_KEY=xxxxx

# Document Verification (Nigeria)
LASRERA_API_KEY=xxxxx
LASRERA_BASE_URL=https://api.lasrera.lg.gov.ng

# Frontend URLs
FRONTEND_URL=http://localhost:5173


# --------------------------------------------------------------------
# ComplyFlow telemetry (instrumentation-only; safe to leave unset)
# --------------------------------------------------------------------
# When ALL of API_KEY / TENANT_ID / ENDPOINT are unset, the SDK never
# initializes and every safeEmit.* call is a no-op. HomeAPP runs
# unchanged. Setting them on activates dataAccess / accessControl /
# dataFlow emission to the configured ComplyFlow ingest endpoint.

# OPTIONAL. ComplyFlow API key issued for this tenant.
COMPLY_FLOW_API_KEY=

# OPTIONAL. Tenant identifier in ComplyFlow.
COMPLY_FLOW_TENANT_ID=

# OPTIONAL. ComplyFlow ingest URL — e.g. http://complyflow:4318 when
# colocated, or https://ingest.complyflow.example over the internet.
COMPLY_FLOW_ENDPOINT=

# OPTIONAL — default: homeai-core-backend. Service identifier attached
# to every emitted event for routing in the ComplyFlow graph.
COMPLY_FLOW_SERVICE_NAME=homeai-core-backend
