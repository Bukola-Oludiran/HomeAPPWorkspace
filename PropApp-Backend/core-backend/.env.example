# Server
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database
DATABASE_URL=postgresql://homeai:homeai_dev@localhost:5432/homeai_dev?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Region Configuration
DEFAULT_REGION=NG

# =====================================
# NIGERIA PROVIDERS
# =====================================

# Payment - Paystack (Nigeria)
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx

# Identity Verification - Smile Identity (Nigeria)
SMILE_IDENTITY_API_KEY=xxxxx
SMILE_IDENTITY_PARTNER_ID=xxxxx

# SMS - Africa's Talking (Nigeria)
AT_API_KEY=xxxxx
AT_USERNAME=sandbox
AT_SENDER_ID=HomeAI

# =====================================
# CANADA PROVIDERS
# =====================================

# Payment - Stripe (Canada)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Identity Verification - Onfido (Canada)
ONFIDO_API_TOKEN=xxxxx
ONFIDO_SANDBOX=true

# SMS - Twilio (Canada)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# =====================================
# SHARED PROVIDERS (All Regions)
# =====================================

# Email - SendGrid
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=noreply@homeai.ng

# Push - Firebase
FCM_PROJECT_ID=homeai-ng
FCM_PRIVATE_KEY=xxxxx
FCM_CLIENT_EMAIL=xxxxx

# Storage - AWS S3
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_REGION=eu-west-1
AWS_S3_BUCKET=homeai-ng-uploads
AWS_CLOUDFRONT_DOMAIN=d1234567890abc.cloudfront.net

# Maps - Google
GOOGLE_MAPS_API_KEY=xxxxx

# Blockchain (Polygon)
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/xxxxx
BLOCKCHAIN_PRIVATE_KEY=xxxxx
ALCHEMY_API_KEY=xxxxx
INFURA_API_KEY=xxxxx

# Frontend URLs
FRONTEND_URL=http://localhost:5173
