// Prisma Schema for HomeAI Nigeria Core Backend
// Based on PRD Section 13 - Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime: pooled connection (Neon pgbouncer endpoint, hostname
  // ends with `-pooler.<region>.aws.neon.tech`). Safe for serverless
  // / many short-lived queries.
  url       = env("DATABASE_URL")
  // Migrations + introspection: direct (non-pooled) connection.
  // Required for `prisma migrate` / `prisma db pull`, which need
  // session-level features that the pooler in transaction mode
  // does not support.
  directUrl = env("DIRECT_URL")
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique @db.VarChar(255)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  role               UserRole
  firstName          String?   @map("first_name") @db.VarChar(100)
  lastName           String?   @map("last_name") @db.VarChar(100)
  phone              String?   @db.VarChar(20)
  avatarUrl          String?   @map("avatar_url")
  walletAddress      String?   @map("wallet_address") @db.VarChar(42)
  verificationLevel  VerificationLevel @default(UNVERIFIED) @map("verification_level")
  isActive           Boolean   @default(true) @map("is_active")
  isEmailVerified    Boolean   @default(false) @map("is_email_verified")
  twoFactorEnabled   Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret    String?   @map("two_factor_secret") @db.VarChar(255)
  regionCode         String    @default("NG") @map("region_code") @db.VarChar(2)
  notificationPreferences Json? @map("notification_preferences")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  profile            UserProfile?
  ownedProperties    Property[]        @relation("PropertyOwner")
  applications       Application[]     @relation("ApplicationTenant")
  tenantLeases       Lease[]           @relation("LeaseTenant")
  landlordLeases     Lease[]           @relation("LeaseLandlord")
  payerTransactions  Transaction[]     @relation("TransactionPayer")
  payeeTransactions  Transaction[]     @relation("TransactionPayee")
  payerEscrows       Escrow[]          @relation("EscrowPayer")
  payeeEscrows       Escrow[]          @relation("EscrowPayee")
  userVerifications  Verification[]    @relation("VerificationUser")
  reviewedVerifications Verification[] @relation("VerificationReviewer")
  maintenanceRequests MaintenanceRequest[] @relation("MaintenanceTenant")
  assignedMaintenance MaintenanceRequest[] @relation("MaintenanceAgent")
  requestedJobs      AgentJob[]        @relation("JobRequester")
  assignedJobs       AgentJob[]        @relation("JobAgent")
  conversations      ConversationParticipant[]
  sentMessages       Message[]
  notifications      Notification[]
  deviceTokens       DeviceToken[]
  favorites          Favorite[]
  refreshTokens      RefreshToken[]
  sessions           Session[]
  sentApplicantInvitations ApplicantInvitation[] @relation("InvitationLandlord")
  acceptedApplicantInvitations ApplicantInvitation[] @relation("InvitationTenant")
  availability       AgentAvailability[]
  reviewsWritten     Review[] @relation("ReviewAuthor")
  reviewsReceived    Review[] @relation("ReviewSubject")
  paymentMethods     PaymentMethod[]
  bankAccounts       BankAccount[]
  payouts            Payout[]
  documents          Document[]
  connectedAccounts  ConnectedAccount[]
  aiSessions         AiSession[]

  @@map("users")
}

model UserProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  profileData Json     @map("profile_data")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @map("token_hash") @db.VarChar(255)
  deviceName   String?   @map("device_name") @db.VarChar(120)
  deviceType   String?   @map("device_type") @db.VarChar(40)
  browser      String?   @db.VarChar(80)
  os           String?   @db.VarChar(80)
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  location     Json?
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([tokenHash])
  @@map("sessions")
}

// ============================================
// PROPERTY MANAGEMENT
// ============================================

model Property {
  id                       String           @id @default(uuid()) @db.Uuid
  ownerId                  String           @map("owner_id") @db.Uuid
  name                     String           @db.VarChar(255)
  description              String?
  propertyType             PropertyType     @map("property_type")
  listingType              ListingType      @map("listing_type")
  price                    Decimal          @db.Decimal(15, 2)
  priceUnit                PriceUnit        @map("price_unit")
  bedrooms                 Int?
  bathrooms                Int?
  squareFeet               Int?             @map("square_feet")
  yearBuilt                Int?             @map("year_built")
  addressStreet            String?          @map("address_street") @db.VarChar(255)
  addressCity              String?          @map("address_city") @db.VarChar(100)
  addressState             String?          @map("address_state") @db.VarChar(100)
  addressZip               String?          @map("address_zip") @db.VarChar(20)
  addressLga               String?          @map("address_lga") @db.VarChar(100)
  addressNeighborhood      String?          @map("address_neighborhood") @db.VarChar(100)
  latitude                 Decimal?         @db.Decimal(10, 8)
  longitude                Decimal?         @db.Decimal(11, 8)
  amenities                String[]
  status                   PropertyStatus   @default(DRAFT)
  verificationTier         VerificationTier @default(UNVERIFIED) @map("verification_tier")
  blockchainVerificationId String?          @map("blockchain_verification_id") @db.VarChar(100)
  regionCode               String           @default("NG") @map("region_code") @db.VarChar(2)
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")

  // Relations
  owner                 User                 @relation("PropertyOwner", fields: [ownerId], references: [id])
  media                 PropertyMedia[]
  applications          Application[]
  leases                Lease[]
  transactions          Transaction[]
  verifications         Verification[]
  maintenanceRequests   MaintenanceRequest[]
  agentJobs             AgentJob[]
  conversations         Conversation[]
  favorites             Favorite[]
  applicantInvitations  ApplicantInvitation[]

  @@index([ownerId])
  @@index([status])
  @@index([listingType])
  @@index([addressCity, addressLga])
  @@map("properties")
}

model PropertyMedia {
  id         String    @id @default(uuid()) @db.Uuid
  propertyId String    @map("property_id") @db.Uuid
  url        String
  type       MediaType @default(IMAGE)
  isPrimary  Boolean   @default(false) @map("is_primary")
  caption    String?   @db.VarChar(255)
  orderIndex Int       @default(0) @map("order_index")
  metadata   Json?     // For 3D tour config, video duration, provider info, etc.
  createdAt  DateTime  @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, type])
  @@map("property_media")
}

// ============================================
// APPLICATIONS & LEASES
// ============================================

model Application {
  id              String            @id @default(uuid()) @db.Uuid
  propertyId      String            @map("property_id") @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  status          ApplicationStatus @default(PENDING)
  personalInfo    Json?             @map("personal_info")
  employmentInfo  Json?             @map("employment_info")
  documents       Json?
  moveInDate      DateTime?         @map("move_in_date") @db.Date
  leaseTerm       Int?              @map("lease_term")
  additionalNotes String?           @map("additional_notes")
  submittedAt     DateTime          @default(now()) @map("submitted_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id])
  tenant   User     @relation("ApplicationTenant", fields: [tenantId], references: [id])
  invitation ApplicantInvitation?

  @@index([propertyId])
  @@index([tenantId])
  @@map("applications")
}

model ApplicantInvitation {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  landlordId    String    @map("landlord_id") @db.Uuid
  propertyId    String    @map("property_id") @db.Uuid
  email         String    @db.VarChar(255)
  personalInfo  Json?     @map("personal_info")
  employmentInfo Json?    @map("employment_info")
  applicationId String?   @unique @map("application_id") @db.Uuid
  acceptedById  String?   @map("accepted_by_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at")
  acceptedAt    DateTime? @map("accepted_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  landlord   User         @relation("InvitationLandlord", fields: [landlordId], references: [id], onDelete: Cascade)
  acceptedBy User?        @relation("InvitationTenant", fields: [acceptedById], references: [id])
  property   Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id])

  @@index([landlordId, createdAt])
  @@index([email, expiresAt])
  @@map("applicant_invitations")
}

model Lease {
  id               String      @id @default(uuid()) @db.Uuid
  propertyId       String      @map("property_id") @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  landlordId       String      @map("landlord_id") @db.Uuid
  startDate        DateTime    @map("start_date") @db.Date
  endDate          DateTime    @map("end_date") @db.Date
  monthlyRent      Decimal     @map("monthly_rent") @db.Decimal(15, 2)
  securityDeposit  Decimal?    @map("security_deposit") @db.Decimal(15, 2)
  terms            Json?
  status           LeaseStatus @default(DRAFT)
  documentUrl      String?     @map("document_url")
  signedByTenant   Boolean     @default(false) @map("signed_by_tenant")
  signedByLandlord Boolean     @default(false) @map("signed_by_landlord")
  blockchainTokenId Int?       @map("blockchain_token_id")
  blockchainTxHash String?     @map("blockchain_tx_hash") @db.VarChar(100)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id])
  tenant   User     @relation("LeaseTenant", fields: [tenantId], references: [id])
  landlord User     @relation("LeaseLandlord", fields: [landlordId], references: [id])

  @@map("leases")
}

// ============================================
// TRANSACTIONS & ESCROW
// ============================================

model Transaction {
  id               String            @id @default(uuid()) @db.Uuid
  type             TransactionType
  payerId          String            @map("payer_id") @db.Uuid
  payeeId          String            @map("payee_id") @db.Uuid
  propertyId       String?           @map("property_id") @db.Uuid
  amount           Decimal           @db.Decimal(15, 2)
  currency         String            @default("NGN") @db.VarChar(3)
  status           TransactionStatus @default(PENDING)
  paymentMethod    String?           @map("payment_method") @db.VarChar(30)
  paymentReference String?           @map("payment_reference") @db.VarChar(100)
  escrowId         String?           @map("escrow_id") @db.VarChar(100)
  blockchainTxHash String?           @map("blockchain_tx_hash") @db.VarChar(100)
  metadata         Json?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  payer    User      @relation("TransactionPayer", fields: [payerId], references: [id])
  payee    User      @relation("TransactionPayee", fields: [payeeId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])
  escrow   Escrow?

  @@index([payerId])
  @@index([payeeId])
  @@map("transactions")
}

model Escrow {
  id                   String       @id @default(uuid()) @db.Uuid
  transactionId        String       @unique @map("transaction_id") @db.Uuid
  payerId              String       @map("payer_id") @db.Uuid
  payeeId              String       @map("payee_id") @db.Uuid
  amount               Decimal      @db.Decimal(15, 2)
  platformFee          Decimal?     @map("platform_fee") @db.Decimal(15, 2)
  status               EscrowStatus @default(CREATED)
  releaseAfter         DateTime?    @map("release_after")
  blockchainEscrowId   String?      @map("blockchain_escrow_id") @db.VarChar(100)
  blockchainTxHash     String?      @map("blockchain_tx_hash") @db.VarChar(100)
  confirmedAt          DateTime?    @map("confirmed_at")
  releasedAt           DateTime?    @map("released_at")
  disputedAt           DateTime?    @map("disputed_at")
  disputeReason        String?      @map("dispute_reason")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  transaction Transaction @relation(fields: [transactionId], references: [id])
  payer       User        @relation("EscrowPayer", fields: [payerId], references: [id])
  payee       User        @relation("EscrowPayee", fields: [payeeId], references: [id])

  @@map("escrows")
}

// ============================================
// VERIFICATION
// ============================================

model Verification {
  id                       String             @id @default(uuid()) @db.Uuid
  userId                   String?            @map("user_id") @db.Uuid
  propertyId               String?            @map("property_id") @db.Uuid
  requestedBy              String?            @map("requested_by") @db.Uuid
  type                     VerificationType
  level                    VerificationLevel
  status                   VerificationStatus @default(PENDING)
  documentUrl              String?            @map("document_url")
  documentType             String?            @map("document_type") @db.VarChar(50)
  documentNumber           String?            @map("document_number") @db.VarChar(100)
  issueDate                DateTime?          @map("issue_date") @db.Date
  expiryDate               DateTime?          @map("expiry_date") @db.Date
  submittedAt              DateTime?          @map("submitted_at")
  reviewedAt               DateTime?          @map("reviewed_at")
  reviewedById             String?            @map("reviewed_by") @db.Uuid
  rejectionReason          String?            @map("rejection_reason")
  blockchainVerificationId String?            @map("blockchain_verification_id") @db.VarChar(100)
  blockchainTxHash         String?            @map("blockchain_tx_hash") @db.VarChar(100)
  metadata                 Json?
  data                     Json?
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  user       User?     @relation("VerificationUser", fields: [userId], references: [id])
  property   Property? @relation(fields: [propertyId], references: [id])
  reviewedBy User?     @relation("VerificationReviewer", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([propertyId])
  @@map("verifications")
}

// ============================================
// MAINTENANCE
// ============================================

model MaintenanceRequest {
  id                String              @id @default(uuid()) @db.Uuid
  propertyId        String              @map("property_id") @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  assignedAgentId   String?             @map("assigned_agent_id") @db.Uuid
  title             String?             @db.VarChar(255)
  description       String?
  category          String              @db.VarChar(100)
  urgency           MaintenancePriority @default(MEDIUM)
  priority          MaintenancePriority @default(MEDIUM)
  status            MaintenanceStatus   @default(SUBMITTED)
  preferredDate     DateTime?           @map("preferred_date")
  preferredTimeSlot String?             @map("preferred_time_slot") @db.VarChar(50)
  photos            String[]            @default([])
  images            String[]            @default([])
  notes             String?
  resolution        String?
  cost              Decimal?            @db.Decimal(10, 2)
  scheduledDate     DateTime?           @map("scheduled_date")
  resolvedAt        DateTime?           @map("resolved_at")
  completedAt       DateTime?           @map("completed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  property      Property @relation(fields: [propertyId], references: [id])
  tenant        User     @relation("MaintenanceTenant", fields: [tenantId], references: [id])
  assignedAgent User?    @relation("MaintenanceAgent", fields: [assignedAgentId], references: [id])

  @@map("maintenance_requests")
}

// ============================================
// AGENT JOBS
// ============================================

model AgentJob {
  id                 String        @id @default(uuid()) @db.Uuid
  type               AgentJobType
  title              String?       @db.VarChar(255)
  description        String?
  category           String?       @db.VarChar(100)
  propertyId         String?       @map("property_id") @db.Uuid
  requesterId        String        @map("requester_id") @db.Uuid
  createdById        String?       @map("created_by_id") @db.Uuid
  assignedAgentId    String?       @map("assigned_agent_id") @db.Uuid
  status             AgentJobStatus @default(OPEN)
  priority           JobPriority   @default(MEDIUM)
  urgency            String?       @db.VarChar(50)
  earnings           Decimal?      @db.Decimal(10, 2)
  payout             Decimal?      @db.Decimal(10, 2)
  scheduledDate      DateTime?     @map("scheduled_date")
  scheduledTime      String?       @map("scheduled_time") @db.VarChar(50)
  notes              String?
  instructions       String?
  completionNotes    String?       @map("completion_notes")
  completionEvidence Json?         @map("completion_evidence")
  completedAt        DateTime?     @map("completed_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  property      Property? @relation(fields: [propertyId], references: [id])
  requester     User      @relation("JobRequester", fields: [requesterId], references: [id])
  assignedAgent User?     @relation("JobAgent", fields: [assignedAgentId], references: [id])

  @@map("agent_jobs")
}

model AgentAvailability {
  id            String   @id @default(uuid()) @db.Uuid
  agentId       String   @map("agent_id") @db.Uuid
  date          DateTime @db.Date
  startTime     String   @map("start_time") @db.VarChar(5)
  endTime       String   @map("end_time") @db.VarChar(5)
  recurring     Boolean  @default(false)
  recurringDays String[] @default([]) @map("recurring_days")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  agent User @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, date])
  @@map("agent_availability")
}

model Review {
  id          String     @id @default(uuid()) @db.Uuid
  authorId    String     @map("reviewer_id") @db.Uuid
  subjectId   String?    @map("reviewee_id") @db.Uuid
  propertyId  String?    @map("property_id") @db.Uuid
  leaseId     String?    @map("lease_id") @db.Uuid
  agentJobId  String?    @map("agent_job_id") @db.Uuid
  type        ReviewType
  rating      Int
  title       String?    @db.VarChar(255)
  body        String?    @map("content")
  isPublic    Boolean    @default(true) @map("is_public")
  isVerified  Boolean    @default(false) @map("is_verified")
  response    String?
  respondedAt DateTime?  @map("responded_at")
  reportCount Int        @default(0) @map("report_count")
  isHidden    Boolean    @default(false) @map("is_hidden")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  author  User  @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject User? @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([subjectId])
  @@index([type])
  @@map("reviews")
}

model PaymentMethod {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  type          String    @db.VarChar(20)
  brand         String?   @db.VarChar(30)
  last4         String    @db.VarChar(4)
  expiryMonth   Int?      @map("expiry_month")
  expiryYear    Int?      @map("expiry_year")
  holderName    String?   @map("holder_name") @db.VarChar(100)
  isDefault     Boolean   @default(false) @map("is_default")
  providerToken String    @map("provider_token") @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("payment_methods")
}

model BankAccount {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  bankCode            String    @map("bank_code") @db.VarChar(10)
  bankName            String    @map("bank_name") @db.VarChar(100)
  accountNumber       String    @map("account_number") @db.VarChar(255)
  accountNumberMasked String    @map("account_number_masked") @db.VarChar(20)
  accountName         String    @map("account_name") @db.VarChar(100)
  accountType         String    @map("account_type") @db.VarChar(20)
  currency            String    @default("NGN") @db.VarChar(3)
  isDefault           Boolean   @default(false) @map("is_default")
  isVerified          Boolean   @default(false) @map("is_verified")
  verifiedAt          DateTime? @map("verified_at")
  recipientCode       String?   @map("recipient_code") @db.VarChar(100)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts Payout[]
  @@index([userId])
  @@map("bank_accounts")
}

model Payout {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  bankAccountId String       @map("bank_account_id") @db.Uuid
  amount        Decimal      @db.Decimal(15, 2)
  currency      String       @default("NGN") @db.VarChar(3)
  status        PayoutStatus @default(PROCESSING)
  reference     String       @unique @db.VarChar(100)
  description   String?      @db.VarChar(255)
  completedAt   DateTime?    @map("completed_at")
  failedAt      DateTime?    @map("failed_at")
  failureReason String?      @map("failure_reason")
  createdAt     DateTime     @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
  @@index([userId])
  @@map("payouts")
}

model Document {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  entityType      String?        @map("entity_type") @db.VarChar(30)
  entityId        String?        @map("entity_id") @db.Uuid
  type            DocumentType
  subtype         String?        @db.VarChar(30)
  name            String         @db.VarChar(255)
  filename        String         @db.VarChar(255)
  mimeType        String         @map("mime_type") @db.VarChar(100)
  size            Int
  storageKey      String         @map("storage_key") @db.VarChar(500)
  thumbnailKey    String?        @map("thumbnail_key") @db.VarChar(500)
  status          DocumentStatus @default(PENDING)
  expiryDate      DateTime?      @map("expiry_date")
  metadata        Json?
  verifiedAt      DateTime?      @map("verified_at")
  verifiedBy      String?        @map("verified_by") @db.Uuid
  rejectionReason String?        @map("rejection_reason")
  uploadedAt      DateTime       @default(now()) @map("uploaded_at")
  deletedAt       DateTime?      @map("deleted_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([type])
  @@map("documents")
}

model ConnectedAccount {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id") @db.VarChar(255)
  email          String        @db.VarChar(255)
  profile        Json?
  connectedAt    DateTime      @default(now()) @map("connected_at")
  lastUsedAt     DateTime      @default(now()) @map("last_used_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, provider])
  @@unique([provider, providerUserId])
  @@map("connected_accounts")
}

// ============================================
// MESSAGING
// ============================================

model Conversation {
  id         String           @id @default(uuid()) @db.Uuid
  type       ConversationType @default(DIRECT)
  propertyId String?          @map("property_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  property     Property?                 @relation(fields: [propertyId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid
  content        String
  messageType    MessageType @default(TEXT) @map("message_type")
  attachments    Json?
  isRead         Boolean     @default(false) @map("is_read")
  read           Boolean     @default(false)
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@map("messages")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String?          @db.VarChar(255)
  body      String?
  message   String?
  data      Json?
  channels  String[]         @default([])
  isRead    Boolean          @default(false) @map("is_read")
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ============================================
// DEVICE TOKENS (for push notifications)
// ============================================

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @db.VarChar(500)
  deviceId  String?  @map("device_id") @db.VarChar(100)
  platform  String   @db.VarChar(20)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@map("device_tokens")
}

// ============================================
// FAVORITES
// ============================================

model Favorite {
  userId     String   @map("user_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
  @@map("favorites")
}

