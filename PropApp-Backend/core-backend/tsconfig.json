{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "lib": [
            "ES2022"
        ],
        "outDir": "./dist",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "moduleResolution": "node",
        "types": [
            "node",
            "jest"
        ],
        "baseUrl": "./src",
        "paths": {
            "@/*": [
                "./*"
            ],
            "@modules/*": [
                "./modules/*"
            ],
            "@common/*": [
                "./common/*"
            ],
            "@config/*": [
                "./config/*"
            ],
            "@integrations/*": [
                "./integrations/*"
            ],
            "@homeai/contracts": [
                "../../../contracts/index.ts"
            ],
            "@homeai/contracts/*": [
                "../../../contracts/*"
            ]
        }
    },
    "include": [
        "src/**/*",
        "tests/**/*",
        "../../contracts/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}