{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "lib": ["ES2022"],
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": false,
        "sourceMap": true,
        "moduleResolution": "node",
        "types": ["node"],
        "baseUrl": "./src",
        "paths": {
            "@/*": ["./*"],
            "@homeai/contracts": ["../../contracts/index.ts"],
            "@homeai/contracts/*": ["../../contracts/*"]
        }
    },
    "include": ["src/**/*", "scripts/**/*"],
    "exclude": ["node_modules", "dist"]
}
