# ====================================================================
# HomeAI AI Service — environment template
# ====================================================================
# Copy to `.env` and fill in. Values marked REQUIRED must be set;
# OPTIONAL values fall back to the documented default.
#
# Schema source-of-truth: src/config/env.ts (zod validation, fail-fast
# at boot). Anything you add here must also be added to the zod schema
# to take effect.
# ====================================================================


# --------------------------------------------------------------------
# HTTP server
# --------------------------------------------------------------------

# OPTIONAL — default: development. One of: development | production | test
NODE_ENV=development

# OPTIONAL — default: 4000. The /v1/chat surface listens here.
PORT=4000

# OPTIONAL — default: http://localhost:5173. Comma-separated origins
# allowed by the CORS middleware. Add your production frontend hostname.
FRONTEND_URL=http://localhost:5173


# --------------------------------------------------------------------
# Auth — must match core-backend
# --------------------------------------------------------------------

# REQUIRED — MUST be byte-identical to core-backend's `JWT_SECRET`.
# Tokens minted by core-backend's auth flow are validated here with this
# same secret. The AI agent never sees this; only the service uses it
# to verify the bearer JWT on incoming chat requests and to sign gRPC
# metadata when calling write tools.
JWT_SECRET=local-development-secret-at-least-32-characters


# --------------------------------------------------------------------
# Database — Neon Postgres (managed)
# --------------------------------------------------------------------
# The AI service has TWO connection roles by design:
#   1. READONLY_DATABASE_URL: SELECT-only role for read tools.
#   2. AISERVICE_DATABASE_URL: write role scoped to ai_sessions* tables
#      (where AI session history persists).
# In dev, both can fall back to the core-backend's DATABASE_URL.
# In production, provision dedicated Postgres roles per the README.

# OPTIONAL — preferred for production. SELECT-only Postgres role.
# Use the Neon pooled endpoint (`-pooler` in hostname) for short-lived
# read queries. Falls back to DATABASE_URL if unset (with a warning log).
READONLY_DATABASE_URL=

# OPTIONAL — preferred for production. Role with INSERT/UPDATE/DELETE
# grants on `ai_sessions` and `ai_session_messages` only. Falls back to
# DATABASE_URL if unset (with a warning log). The application layer does
# NOT write to any other tables; enforcement is the role's responsibility.
AISERVICE_DATABASE_URL=

# OPTIONAL but recommended in dev — fallback when the two role-scoped
# URLs above aren't set. Same shape as core-backend's DATABASE_URL.
DATABASE_URL=postgresql://homeai:homeai_dev@localhost:5433/homeai_dev?schema=public


# --------------------------------------------------------------------
# Core backend gRPC — mutation surface for write tools
# --------------------------------------------------------------------

# OPTIONAL — default: localhost
CORE_BACKEND_GRPC_HOST=localhost

# OPTIONAL — default: 50051. Must match core-backend's GRPC_PORT.
CORE_BACKEND_GRPC_PORT=50051


# --------------------------------------------------------------------
# Session lifecycle
# --------------------------------------------------------------------

# OPTIONAL — default: 30. In-memory session state (JWT, agent runtime)
# evicts after this many minutes of inactivity. The persistent DB row in
# `ai_sessions` is not deleted — only the volatile state. v2 will swap
# the in-memory store for Redis.
SESSION_TTL_MINUTES=30


# --------------------------------------------------------------------
# LLM provider (Anthropic via @anthropic-ai/sdk)
# --------------------------------------------------------------------
# If ANTHROPIC_API_KEY is unset, /v1/chat falls back to an echo response
# with a "LLM not configured" notice. Set it to flip on the real
# tool-driven chat path.

# OPTIONAL — default: anthropic. Currently the only supported provider.
LLM_PROVIDER=anthropic

# OPTIONAL — default: claude-3-5-sonnet-20241022.
LLM_MODEL=claude-3-5-sonnet-20241022

# REQUIRED for LLM-driven chat. Leave blank to use the echo fallback.
ANTHROPIC_API_KEY=


# --------------------------------------------------------------------
# Hardening
# --------------------------------------------------------------------

# OPTIONAL — default: 30. Per-userId fixed-window rate limit (per minute).
# Exceeding returns 429 with a Retry-After header. Persists in-memory; v2
# swaps to Redis if multi-instance.
CHAT_RATE_LIMIT_PER_MIN=30

# OPTIONAL — default: stdout. When set, audit events (tool calls, chat
# turns, rate-limit hits, auth failures) append-write as JSONL to this
# file path. v2 pipes to a SIEM/Loki sink.
# AUDIT_LOG_PATH=/var/log/homeai-ai/audit.jsonl
