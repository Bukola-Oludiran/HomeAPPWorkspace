{
  "name": "homeai-ai-service",
  "version": "0.1.0",
  "description": "HomeAI AI service — pi-mono coding agent, generative UI, gRPC writes, read-only Prisma reads",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "prisma:sync": "cp ../PropApp-Backend/core-backend/prisma/schema.prisma prisma/schema.prisma && prisma generate",
    "prisma:generate": "prisma generate",
    "smoke:echo": "tsx scripts/echo-smoke.ts",
    "smoke:p3": "tsx scripts/p3-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.10",
    "@mariozechner/pi-ai": "^0.73.1",
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@prisma/client": "^5.22.0",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "prisma": "^5.22.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
